# Copy this file to .env, fill it in, then run:   python3 tools/make_secrets.py
# .env and the generated secrets.h files are in .gitignore and never committed.

# WiFi network (2.4 GHz) used by the ESP32, the ESP8266 and the laptop
WIFI_SSID=your-wifi-name
WIFI_PASSWORD=your-wifi-password

# LAN IP of the laptop running tools/stress_server.py  (find it with: hostname -I)
LAPTOP_IP=192.168.1.100
